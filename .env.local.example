# Project-local credentials for CLI tools (Supabase, Vercel, etc).
#
# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored and is ONLY used by scripts in the scripts/ folder.
# Do NOT put Vite runtime vars here — those go in .env.

# ----- Supabase -----
# Personal Access Token (NOT the service_role key).
# Get it at: https://supabase.com/dashboard/account/tokens
# Format: sbp_...
SUPABASE_ACCESS_TOKEN=

# Project reference id (the subdomain of your supabase.co URL).
# For this project: teewkafclgpfpczftvah
SUPABASE_PROJECT_REF=teewkafclgpfpczftvah

# ----- GitHub -----
# Personal access token with `repo` scope for git push/pull to this repo.
# Get it at: https://github.com/settings/tokens?type=beta (fine-grained, recommended)
# or: https://github.com/settings/tokens (classic, with `repo` scope)
# Run `bash scripts/setup-git-auth.sh` after filling this in to wire git.
GITHUB_TOKEN=
GITHUB_USERNAME=mariodolo2025

# ----- Vercel (optional, for deploys) -----
# Personal token: https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
